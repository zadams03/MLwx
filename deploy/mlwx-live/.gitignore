# MLwx-live: what must not enter the history (the log and the state do).
__pycache__/
*.pyc
.DS_Store
# the MLwx code is checked out at a pinned commit for each run
mlwx/
# the frozen models come from a Release asset
models/
# the page is built by each run and published to GitHub Pages
site/
# partial and temporary files are never committed: a log or snapshot file is written under a
# temporary name first (WF07, D125.8)
*.partial
*.tmp
